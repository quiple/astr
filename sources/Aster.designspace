<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <!-- `input` is the public OpenType value; `output` is Glyphs' design coordinate. -->
    <axis tag="wght" name="Weight" minimum="200" maximum="600" default="400">
      <map input="200" output="225"/>
      <map input="300" output="300"/>
      <map input="400" output="400"/>
      <map input="500" output="500"/>
      <map input="600" output="550"/>
    </axis>
    <axis tag="opsz" name="Optical size" minimum="14" maximum="32" default="14"/>
  </axes>

  <sources>
    <!-- Editable Text masters from Aster.glyphspackage. -->
    <source filename="masters/Aster-ExtraLight.ufo" name="Aster ExtraLight Text" familyname="Aster" stylename="ExtraLight">
      <location><dimension name="Weight" xvalue="225"/><dimension name="Optical size" xvalue="14"/></location>
    </source>
    <source filename="masters/Aster-Light.ufo" name="Aster Light Text" familyname="Aster" stylename="Light">
      <location><dimension name="Weight" xvalue="325"/><dimension name="Optical size" xvalue="14"/></location>
    </source>
    <source filename="masters/Aster-Regular.ufo" name="Aster Regular Text Master" familyname="Aster" stylename="Regular">
      <lib copy="1"/><groups copy="1"/><features copy="1"/><info copy="1"/>
      <location><dimension name="Weight" xvalue="400"/><dimension name="Optical size" xvalue="14"/></location>
    </source>
    <source filename="masters/Aster-Text.ufo" name="Aster Text" familyname="Aster" stylename="Text">
      <location><dimension name="Weight" xvalue="425"/><dimension name="Optical size" xvalue="14"/></location>
    </source>
    <source filename="masters/Aster-Medium.ufo" name="Aster Medium Text" familyname="Aster" stylename="Medium">
      <location><dimension name="Weight" xvalue="475"/><dimension name="Optical size" xvalue="14"/></location>
    </source>
    <source filename="masters/Aster-SemiBold.ufo" name="Aster SemiBold Text" familyname="Aster" stylename="SemiBold">
      <location><dimension name="Weight" xvalue="550"/><dimension name="Optical size" xvalue="14"/></location>
    </source>

    <!-- Display masters created by `make init-aster`/`make sync-inter`. -->
    <source filename="masters/Aster-DisplayExtraLight.ufo" name="Aster Display ExtraLight" familyname="Aster" stylename="Display ExtraLight">
      <location><dimension name="Weight" xvalue="225"/><dimension name="Optical size" xvalue="32"/></location>
    </source>
    <source filename="masters/Aster-DisplayLight.ufo" name="Aster Display Light" familyname="Aster" stylename="Display Light">
      <location><dimension name="Weight" xvalue="325"/><dimension name="Optical size" xvalue="32"/></location>
    </source>
    <source filename="masters/Aster-DisplayRegular.ufo" name="Aster Display Regular" familyname="Aster" stylename="Display Regular">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Optical size" xvalue="32"/></location>
    </source>
    <source filename="masters/Aster-DisplayText.ufo" name="Aster Display Text" familyname="Aster" stylename="Display Text">
      <location><dimension name="Weight" xvalue="425"/><dimension name="Optical size" xvalue="32"/></location>
    </source>
    <source filename="masters/Aster-DisplayMedium.ufo" name="Aster Display Medium" familyname="Aster" stylename="Display Medium">
      <location><dimension name="Weight" xvalue="475"/><dimension name="Optical size" xvalue="32"/></location>
    </source>
    <source filename="masters/Aster-DisplaySemiBold.ufo" name="Aster Display SemiBold" familyname="Aster" stylename="Display SemiBold">
      <location><dimension name="Weight" xvalue="550"/><dimension name="Optical size" xvalue="32"/></location>
    </source>

  </sources>

  <instances>
    <!-- Static exports use the Text optical size. Locations are design coordinates. -->
    <instance name="Aster ExtraLight" familyname="Aster" stylename="ExtraLight" filename="instance_ufos/Aster-ExtraLight.ufo">
      <location><dimension name="Weight" xvalue="225"/><dimension name="Optical size" xvalue="14"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>200</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Light" familyname="Aster" stylename="Light" filename="instance_ufos/Aster-Light.ufo">
      <location><dimension name="Weight" xvalue="300"/><dimension name="Optical size" xvalue="14"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>300</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Regular" familyname="Aster" stylename="Regular" filename="instance_ufos/Aster-Regular.ufo">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Optical size" xvalue="14"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>400</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Medium" familyname="Aster" stylename="Medium" filename="instance_ufos/Aster-Medium.ufo">
      <location><dimension name="Weight" xvalue="500"/><dimension name="Optical size" xvalue="14"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>500</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster SemiBold" familyname="Aster" stylename="SemiBold" filename="instance_ufos/Aster-SemiBold.ufo">
      <location><dimension name="Weight" xvalue="550"/><dimension name="Optical size" xvalue="14"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>600</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>

    <!-- Inter-style Display exports: same style names, separate family, opsz=32. -->
    <instance name="Aster Display ExtraLight" familyname="Aster Display" stylename="ExtraLight" filename="instance_ufos/AsterDisplay-ExtraLight.ufo">
      <location><dimension name="Weight" xvalue="225"/><dimension name="Optical size" xvalue="32"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>200</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Display Light" familyname="Aster Display" stylename="Light" filename="instance_ufos/AsterDisplay-Light.ufo">
      <location><dimension name="Weight" xvalue="300"/><dimension name="Optical size" xvalue="32"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>300</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Display Regular" familyname="Aster Display" stylename="Regular" filename="instance_ufos/AsterDisplay-Regular.ufo">
      <location><dimension name="Weight" xvalue="400"/><dimension name="Optical size" xvalue="32"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>400</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Display Medium" familyname="Aster Display" stylename="Medium" filename="instance_ufos/AsterDisplay-Medium.ufo">
      <location><dimension name="Weight" xvalue="500"/><dimension name="Optical size" xvalue="32"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>500</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
    <instance name="Aster Display SemiBold" familyname="Aster Display" stylename="SemiBold" filename="instance_ufos/AsterDisplay-SemiBold.ufo">
      <location><dimension name="Weight" xvalue="550"/><dimension name="Optical size" xvalue="32"/></location>
      <lib><dict><key>com.schriftgestaltung.export</key><true/><key>com.schriftgestaltung.weight</key><integer>600</integer><key>com.schriftgestaltung.width</key><string>Medium (normal)</string></dict></lib>
    </instance>
  </instances>
</designspace>
